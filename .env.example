NODE_ENV=development
PORT=5000
JWT_SECRET=your_jwt_secret_key_here_change_in_production
LOG_QUERIES=true
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ediss_db
DB_USER=postgres
DB_PASSWORD=your_db_password

# Shared invoices database — used for BOTH air and sea invoice numbers/rows
# so invoice numbers are never duplicated across the two systems.
INVOICES_DB_HOST=localhost
INVOICES_DB_PORT=5432
INVOICES_DB_NAME=ediss_invoices
INVOICES_DB_USER=postgres
INVOICES_DB_PASSWORD=your_db_password

# CORS
FRONTEND_URL=http://localhost:3000
