{
  "name": "ediss-backend",
  "version": "1.0.0",
  "description": "EDISS - Electronic Data Interchange for Shipping System - Backend",
  "main": "dist/index.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prebuild": "rm -rf dist",
    "seed": "ts-node src/seeder.ts",
    "test:tax-invoice": "ts-node --transpile-only src/taxInvoiceSelfTest.ts",
    "migrate:tax-invoice": "ts-node --transpile-only src/runTaxInvoiceMigration.ts"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.15.2",
    "pg": "^8.11.3",
    "typescript": "^5.3.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.13.9",
    "ts-node-dev": "^2.0.0"
  }
}
